# --- Sanity CMS ---
# Create a project at https://sanity.io/manage, then fill these in.
# Until set, the site renders bundled sample content (lib/content/sample.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read token only needed if you query drafts / private datasets.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook -> /api/revalidate (set the same value
# in the webhook header `x-revalidate-secret`).
SANITY_REVALIDATE_SECRET=

# --- Google Places (reviews) ---
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Restrict the key to the
# Places API and your server IPs. Leave blank to use curated sample reviews.
GOOGLE_MAPS_API_KEY=

# --- Site ---
# Canonical production URL (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://www.clearkayakingadventures.com
